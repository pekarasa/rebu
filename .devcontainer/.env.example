# Template fuer .devcontainer/.env (gitignored).
# Kopiere diese Datei nach .devcontainer/.env und passe die Werte an.
#
# docker-compose liest .env automatisch beim Container-Start.

# ---------------------------------------------------------------------------
# opencode: Host-Credentials & -Config in den Container spiegeln
# ---------------------------------------------------------------------------
# Pfade zu den Host-Dateien, die als Bind-Mount read-only ins Container-
# User-Home gespiegelt werden. Beide Dateien MUESSEN existieren, sonst
# scheitert der Container-Start.
#
# Linux / macOS:
#   OPENCODE_AUTH_FILE=${HOME}/.local/share/opencode/auth.json
#   OPENCODE_CONFIG_FILE=${HOME}/.config/opencode/opencode.jsonc
#
# Windows (Docker Desktop uebersetzt den Pfad automatisch):
#   OPENCODE_AUTH_FILE=${USERPROFILE}/.local/share/opencode/auth.json
#   OPENCODE_CONFIG_FILE=${USERPROFILE}/.config/opencode/opencode.jsonc
#
# Falls du die Mounts nicht brauchst (z.B. CI, Teammitglied ohne opencode):
# die entsprechenden Mounts in docker-compose.yml auskommentieren.
OPENCODE_AUTH_FILE=
OPENCODE_CONFIG_FILE=

# Pfad zum Rules/Instructions-Ordner auf dem Host. Muss zu den relativen
# `instructions`-Angaben in opencode.jsonc passen. Beispiel:
#   OPENCODE_RULES_DIR=${USERPROFILE}/OneDrive - THALES SA/Documents/Cline/Rules
OPENCODE_RULES_DIR=

# ---------------------------------------------------------------------------
# Proxy-Overrides
# ---------------------------------------------------------------------------
# NO_PROXY/no_proxy werden vom Docker-Daemon injiziert, aber zusaetzliche
# Firmen-interne Hosts (z. B. Synapse-Gateway) muessen hier ergaenzt werden,
# damit sie am Zscaler/Firmen-Proxy vorbei direkt angesprochen werden.
# Beispiel:
#   NO_PROXY=127.0.0.1,localhost,llm.synapse.thalescloud.io
#   no_proxy=${NO_PROXY}

# ---------------------------------------------------------------------------
# Optional: LLM-Provider-API-Keys
# ---------------------------------------------------------------------------
# Normalerweise liest opencode die Keys aus auth.json. Wenn du zusaetzlich
# oder stattdessen ENVs nutzen willst, kannst du sie hier setzen; sie werden
# durch die environment-Liste in docker-compose.yml an den Container
# weitergereicht.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# OPENCODE_API_KEY=
# OPENCODE_PROVIDER=
# OPENCODE_MODEL=
# OPENCODE_THEME=
# SYNAPSE_API_KEY=    # fuer Thales Synapse Gateway (siehe opencode.jsonc)
