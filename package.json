{
  "name": "rebu",
  "version": "1.0.0",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --configuration=ci",
    "lint": "ng lint",
    "cap:sync": "npx cap sync",
    "build:android": "cd android && ./gradlew assembleDebug --no-daemon",
    "build:android:release": "cd android && ./gradlew assembleRelease --no-daemon",
    "keystore:generate": "bash scripts/generate-keystore.sh",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@capacitor/cli": "8.4.3",
    "@capacitor/ios": "^8.5.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "~4.1.11"
  },
  "description": "An Ionic project",
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css,json,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
