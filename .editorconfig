root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ts]
quote_type = single

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.gradle]
indent_size = 4

[*.{kt,kts,java}]
indent_size = 4

[*.{bat,cmd,ps1}]
end_of_line = crlf
